<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.CreatePlayListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="10"
    mc:Ignorable="d">

    <!--  新建歌单弹窗: 新建歌单 / 从网络导入 / 从本地导入 三个 Tab(下划线指示, 同在线搜索页)  -->
    <StackPanel Width="440" Spacing="14">
        <!--  Tab 栏(Button 实现, 点击切换; ListView 直接放 ListViewItem 不触发 ItemClick)  -->
        <StackPanel Orientation="Horizontal">
            <Button
                x:Name="TabCreateButton"
                Padding="10,6,10,4"
                Background="Transparent"
                BorderThickness="0"
                Click="TabCreate_Click">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="TabCreateHeader" FontWeight="SemiBold" />
                    <!--  选中下划线指示器: 外层固定高度占位, 避免选中/未选中项高度跳变  -->
                    <Grid Height="3">
                        <Border
                            x:Name="TabCreateIndicator"
                            Height="2.5"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="1.5" />
                    </Grid>
                </StackPanel>
            </Button>
            <Button
                x:Name="TabNetworkButton"
                Padding="10,6,10,4"
                Background="Transparent"
                BorderThickness="0"
                Click="TabNetwork_Click">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="TabNetworkHeader" FontWeight="SemiBold" />
                    <Grid Height="3">
                        <Border
                            x:Name="TabNetworkIndicator"
                            Height="2.5"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="1.5"
                            Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Button>
            <Button
                x:Name="TabLocalButton"
                Padding="10,6,10,4"
                Background="Transparent"
                BorderThickness="0"
                Click="TabLocal_Click">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="TabLocalHeader" FontWeight="SemiBold" />
                    <Grid Height="3">
                        <Border
                            x:Name="TabLocalIndicator"
                            Height="2.5"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="1.5"
                            Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Tab 1: 新建歌单  -->
        <StackPanel x:Name="CreatePanel" Spacing="12">
            <TextBox x:Name="NameTextBox" MaxLength="40" />
            <Button
                x:Name="CreateButton"
                HorizontalAlignment="Stretch"
                Click="CreateButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock x:Name="CreateButtonText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Tab 2: 从网络导入(插件 importMusicSheet)  -->
        <StackPanel x:Name="NetworkPanel" Spacing="12" Visibility="Collapsed">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="NetworkSourceLabel"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox
                    x:Name="PluginComboBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Metadata.Platform" />
                <TextBlock
                    x:Name="NoPluginHint"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBox x:Name="UrlTextBox" />
            <Button
                x:Name="ImportNetworkButton"
                HorizontalAlignment="Stretch"
                Click="ImportNetworkButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                    <TextBlock x:Name="ImportNetworkButtonText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Tab 3: 从本地导入(M3U/M3U8 与 MusicFree 备份)  -->
        <StackPanel x:Name="LocalPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock
                x:Name="LocalHintText"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Name="SelectFileButton"
                HorizontalAlignment="Stretch"
                Click="SelectFileButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    <TextBlock x:Name="SelectFileButtonText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</ContentDialog>
