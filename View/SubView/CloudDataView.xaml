<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.SubView.CloudDataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:WinUIMusicPlayer.Services.Account"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:views="using:WinUIMusicPlayer.View.SubView"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  卡片  -->
        <Style x:Key="CloudCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--  强调色渐变徽章  -->
        <LinearGradientBrush x:Key="CloudAccentDiagonalBrush" EndPoint="1,1" StartPoint="0,0">
            <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight1}" />
            <GradientStop Offset="0.5" Color="{ThemeResource SystemAccentColor}" />
            <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorDark1}" />
        </LinearGradientBrush>

        <!--  入口卡片按钮(概览页 歌单/收藏/插件/用户)  -->
        <Style x:Key="CloudEntryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--  批量操作小按钮  -->
        <Style x:Key="CloudBatchButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  列表项容器  -->
        <Style x:Key="CloudListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!--  云端歌曲行(歌单详情/收藏共用)  -->
        <DataTemplate x:Key="CloudSongItemTemplate" x:DataType="services:CloudSongItem">
            <Border
                Padding="12,8"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="36">
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xF0387;" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind tools:BindUtils.CloudSongSubtitle(Artist, Album), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(IsOnline), Mode=OneWay}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                Text="{x:Bind tools:BindUtils.CloudOnlineBadge(Title), Mode=OneWay}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DurationText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="3"
                        Padding="6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SongDeleteButton_Click"
                        IsEnabled="{x:Bind CanDelete, Mode=OneWay}">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  云端歌单行  -->
        <DataTemplate x:Key="CloudPlaylistItemTemplate" x:DataType="services:CloudPlaylistSummary">
            <Border
                Padding="12,8"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="44">
                    <Grid Grid.Column="0" Width="44" Height="44">
                        <Border
                            Width="44"
                            Height="44"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Grid>
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xF0CB8;" />
                                <Image
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Source="{x:Bind tools:BindUtils.CloudCoverToImage(CoverUrl), Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind tools:BindUtils.CloudPlaylistSubtitle(SongCount, CreatedAt), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Padding="6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PlaylistDeleteButton_Click">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  云端插件行  -->
        <DataTemplate x:Key="CloudPluginItemTemplate" x:DataType="services:CloudPluginSummary">
            <Border
                Padding="12,8"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="40">
                    <Border
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                            FontSize="17"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xF0A66;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind tools:BindUtils.CloudPluginSubtitle(Version, Author), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                        <!--  已启用(绿) / 已停用(灰) 双态胶囊  -->
                        <Border
                            Padding="8,3"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(Enabled), Mode=OneWay}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Text="{x:Bind tools:BindUtils.CloudEnabledBadge(Enabled), Mode=OneWay}" />
                        </Border>
                        <Border
                            Padding="8,3"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="10"
                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(Enabled), Mode=OneWay}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind tools:BindUtils.CloudDisabledBadge(Enabled), Mode=OneWay}" />
                        </Border>
                    </Grid>
                    <Button
                        Grid.Column="3"
                        Padding="6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PluginDeleteButton_Click">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE74D;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!--  顶栏: 返回 + 标题 + 刷新  -->
        <Grid
            Grid.Row="0"
            Margin="8,2,8,6"
            ColumnDefinitions="Auto,*,Auto">
            <Button
                Grid.Column="0"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                Click="BackButton_Click">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="SectionTitleText"
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                Click="RefreshButton_Click">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <!--  加载中  -->
        <StackPanel
            x:Name="LoadingPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <ProgressRing Width="36" Height="36" IsActive="True" />
        </StackPanel>

        <!--  错误态  -->
        <StackPanel
            x:Name="ErrorPanel"
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <Border
                Padding="16"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                        FontSize="18"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xF0164;" />
                    <TextBlock
                        x:Name="ErrorText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Button
                x:Name="RetryButton"
                HorizontalAlignment="Center"
                Click="RetryButton_Click">
                <TextBlock x:Name="RetryButtonText" />
            </Button>
        </StackPanel>

        <!--  内容区  -->
        <ScrollViewer x:Name="ContentRoot" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="560"
                Margin="16,4,16,24"
                HorizontalAlignment="Center"
                Spacing="12">

                <!-- ═════ 概览 ═════ -->
                <StackPanel x:Name="OverviewSection" Spacing="12">
                    <!--  摘要卡: 云徽章 + 上次上传 + 四项统计  -->
                    <Border Padding="20" Style="{StaticResource CloudCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="{StaticResource CloudAccentDiagonalBrush}"
                                    CornerRadius="8">
                                    <FontIcon
                                        FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                        FontSize="16"
                                        Foreground="White"
                                        Glyph="&#xF0163;" />
                                </Border>
                                <TextBlock
                                    x:Name="LastUploadText"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*,*,*">
                                <!--  歌单  -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xF0CB8;" />
                                    <TextBlock
                                        x:Name="StatPlaylistsText"
                                        HorizontalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold" />
                                    <TextBlock
                                        x:Name="StatPlaylistsLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <!--  歌曲  -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xF0387;" />
                                    <TextBlock
                                        x:Name="StatSongsText"
                                        HorizontalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold" />
                                    <TextBlock
                                        x:Name="StatSongsLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <!--  收藏  -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xF02D5;" />
                                    <TextBlock
                                        x:Name="StatFavoritesText"
                                        HorizontalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold" />
                                    <TextBlock
                                        x:Name="StatFavoritesLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <!--  插件  -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xF0A66;" />
                                    <TextBlock
                                        x:Name="StatPluginsText"
                                        HorizontalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold" />
                                    <TextBlock
                                        x:Name="StatPluginsLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SectionListTitle" Margin="4,4,0,0" FontSize="15" FontWeight="SemiBold" />

                    <!--  入口: 歌单  -->
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="PlaylistsEntry_Click"
                        Style="{StaticResource CloudEntryButtonStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="36">
                            <FontIcon
                                Grid.Column="0"
                                FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xF0CB8;" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,8,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:Name="EntryPlaylistsTitle" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="EntryPlaylistsSub"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE76B;" />
                        </Grid>
                    </Button>
                    <!--  入口: 收藏  -->
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="FavoritesEntry_Click"
                        Style="{StaticResource CloudEntryButtonStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="36">
                            <FontIcon
                                Grid.Column="0"
                                FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xF02D5;" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,8,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:Name="EntryFavoritesTitle" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="EntryFavoritesSub"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE76B;" />
                        </Grid>
                    </Button>
                    <!--  入口: 插件  -->
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="PluginsEntry_Click"
                        Style="{StaticResource CloudEntryButtonStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="36">
                            <FontIcon
                                Grid.Column="0"
                                FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xF0A66;" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,8,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:Name="EntryPluginsTitle" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="EntryPluginsSub"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE76B;" />
                        </Grid>
                    </Button>
                    <!--  入口: 用户  -->
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="UserEntry_Click"
                        Style="{StaticResource CloudEntryButtonStyle}">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="36">
                            <FontIcon
                                Grid.Column="0"
                                FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xF0B55;" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,8,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:Name="EntryUserTitle" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="EntryUserSub"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE76B;" />
                        </Grid>
                    </Button>

                    <!--  清空云端数据(有数据时显示)  -->
                    <Button
                        x:Name="ClearButton"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        Click="ClearButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsBusy), Mode=OneWay}" />
                            <FontIcon
                                FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                FontSize="15"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xF0B89;" />
                            <TextBlock
                                x:Name="ClearButtonText"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ═════ 云端歌单 ═════ -->
                <StackPanel x:Name="PlaylistsSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PlaylistsBatchModeButton"
                            Click="PlaylistsBatchMode_Click"
                            Style="{StaticResource CloudBatchButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xF148B;" />
                                <TextBlock x:Name="PlaylistsBatchModeText" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="PlaylistsSelectAllButton"
                            Click="PlaylistsSelectAll_Click"
                            Style="{StaticResource CloudBatchButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xF0486;" />
                                <TextBlock x:Name="PlaylistsSelectAllText" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="PlaylistsDeleteButton"
                            Click="PlaylistsDeleteSelected_Click"
                            IsEnabled="False"
                            Style="{StaticResource CloudBatchButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock x:Name="PlaylistsDeleteText" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="PlaylistsEmptyText"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="PlaylistsListView"
                        IsItemClickEnabled="True"
                        ItemClick="PlaylistsListView_ItemClick"
                        ItemContainerStyle="{StaticResource CloudListItemStyle}"
                        ItemTemplate="{StaticResource CloudPlaylistItemTemplate}"
                        SelectionChanged="PlaylistsListView_SelectionChanged"
                        SelectionMode="None" />
                </StackPanel>

                <!-- ═════ 歌单详情 ═════ -->
                <StackPanel x:Name="PlaylistDetailSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock
                        x:Name="PlaylistDetailMetaText"
                        Margin="4,0,0,4"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SongsBatchModeButton"
                            Click="SongsBatchMode_Click"
                            Style="{StaticResource CloudBatchButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xF148B;" />
                                <TextBlock x:Name="SongsBatchModeText" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SongsSelectAllButton"
                            Click="SongsSelectAll_Click"
                            Style="{StaticResource CloudBatchButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xF0486;" />
                                <TextBlock x:Name="SongsSelectAllText" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SongsDeleteButton"
                            Click="SongsDeleteSelected_Click"
                            IsEnabled="False"
                            Style="{StaticResource CloudBatchButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock x:Name="SongsDeleteText" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="SongsEmptyText"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="SongsListView"
                        ItemContainerStyle="{StaticResource CloudListItemStyle}"
                        ItemTemplate="{StaticResource CloudSongItemTemplate}"
                        SelectionChanged="SongsListView_SelectionChanged"
                        SelectionMode="None" />
                </StackPanel>

                <!-- ═════ 云端收藏 ═════ -->
                <StackPanel x:Name="FavoritesSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="FavoritesBatchModeButton"
                            Click="FavoritesBatchMode_Click"
                            Style="{StaticResource CloudBatchButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xF148B;" />
                                <TextBlock x:Name="FavoritesBatchModeText" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="FavoritesSelectAllButton"
                            Click="FavoritesSelectAll_Click"
                            Style="{StaticResource CloudBatchButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xF0486;" />
                                <TextBlock x:Name="FavoritesSelectAllText" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="FavoritesDeleteButton"
                            Click="FavoritesDeleteSelected_Click"
                            IsEnabled="False"
                            Style="{StaticResource CloudBatchButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock x:Name="FavoritesDeleteText" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="FavoritesEmptyText"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="FavoritesListView"
                        ItemContainerStyle="{StaticResource CloudListItemStyle}"
                        ItemTemplate="{StaticResource CloudSongItemTemplate}"
                        SelectionChanged="FavoritesListView_SelectionChanged"
                        SelectionMode="None" />
                </StackPanel>

                <!-- ═════ 云端插件 ═════ -->
                <StackPanel x:Name="PluginsSection" Spacing="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="PluginsBatchModeButton"
                            Click="PluginsBatchMode_Click"
                            Style="{StaticResource CloudBatchButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xF148B;" />
                                <TextBlock x:Name="PluginsBatchModeText" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="PluginsSelectAllButton"
                            Click="PluginsSelectAll_Click"
                            Style="{StaticResource CloudBatchButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xF0486;" />
                                <TextBlock x:Name="PluginsSelectAllText" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="PluginsDeleteButton"
                            Click="PluginsDeleteSelected_Click"
                            IsEnabled="False"
                            Style="{StaticResource CloudBatchButtonStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock x:Name="PluginsDeleteText" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="PluginsEmptyText"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="PluginsListView"
                        ItemContainerStyle="{StaticResource CloudListItemStyle}"
                        ItemTemplate="{StaticResource CloudPluginItemTemplate}"
                        SelectionChanged="PluginsListView_SelectionChanged"
                        SelectionMode="None" />
                </StackPanel>

                <!-- ═════ 云端用户 ═════ -->
                <StackPanel x:Name="UserSection" Spacing="12" Visibility="Collapsed">
                    <!--  账号卡  -->
                    <Border Padding="20" Style="{StaticResource CloudCardStyle}">
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <Grid
                                Width="64"
                                Height="64"
                                Background="{StaticResource CloudAccentDiagonalBrush}"
                                CornerRadius="32">
                                <TextBlock
                                    x:Name="UserInitialText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </Grid>
                            <TextBlock
                                x:Name="UserNicknameText"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="UserIdText"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <!--  注册信息  -->
                    <Border Padding="20" Style="{StaticResource CloudCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock
                                    x:Name="UserEmailLabel"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="UserEmailText"
                                    Grid.Column="1"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock
                                    x:Name="UserClientLabel"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="UserClientText" Grid.Column="1" />
                            </Grid>
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock
                                    x:Name="UserCreatedLabel"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="UserCreatedText" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!--  上传时间  -->
                    <Border Padding="20" Style="{StaticResource CloudCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock
                                    x:Name="UploadPlaylistsLabel"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="UploadPlaylistsText" Grid.Column="1" />
                            </Grid>
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock
                                    x:Name="UploadPluginsLabel"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="UploadPluginsText" Grid.Column="1" />
                            </Grid>
                            <Grid ColumnDefinitions="96,*">
                                <TextBlock
                                    x:Name="UploadSettingsLabel"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="UploadSettingsText" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        x:Name="UserNotFoundText"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
