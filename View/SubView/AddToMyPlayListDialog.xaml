<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.AddToMyPlayListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="10"
    mc:Ignorable="d">

    <StackPanel MinWidth="340" Spacing="12">
        <!--  已有歌单列表: 点击即把当前歌曲收入该歌单  -->
        <TextBlock x:Name="ExistingHeader" FontWeight="SemiBold" />
        <ListView
            x:Name="PlayListListView"
            MaxHeight="260"
            IsItemClickEnabled="True"
            ItemClick="PlayListListView_ItemClick"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" Padding="4,6">
                        <FontIcon
                            Width="20"
                            VerticalAlignment="Center"
                            Glyph="&#xE93C;" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis">
                            <Run FontWeight="SemiBold" Text="{Binding Name}" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="  ·  " />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SongCount}" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock
            x:Name="EmptyHint"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />
        <!--  新建歌单并添加当前歌曲  -->
        <TextBox x:Name="NameTextBox" />
        <Button
            x:Name="CreateAndAddButton"
            HorizontalAlignment="Stretch"
            Click="CreateAndAddButton_Click"
            Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</ContentDialog>
