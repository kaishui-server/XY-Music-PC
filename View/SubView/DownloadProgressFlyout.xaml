<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.SubView.DownloadProgressFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Margin="0,52,0,0"
    HorizontalAlignment="Center"
    VerticalAlignment="Top"
    Visibility="Collapsed"
    mc:Ignorable="d">

    <!--
        悬浮小弹窗: 背景实时模糊(Composition Backdrop) + 白色半透明 tint, 380 宽, 挂根 Grid 顶部居中。
        blurHost 为独立底层宿主(SetElementChildVisual 的 visual 渲染在 XAML 内容之上, 不能挂内容层)。
        不能加深色伪阴影层 —— 模糊会采样到背后的阴影, 混出黑灰色。
    -->
    <Grid Width="380">
        <!--  模糊宿主: 空元素, 模糊 visual 注入这里, 位于卡片所有内容之下  -->
        <Border x:Name="blurHost" CornerRadius="10" />
        <!--  白色半透明 tint: 全卡覆盖, 叠在模糊层之上、边框与内容之下(不能放进 cardRoot 内, 否则 Padding 环带无 tint, 呈现里外两层)  -->
        <Border Background="#73FFFFFF" CornerRadius="10" />
        <!--  卡片主体: 边框 + 内容  -->
        <Border
            x:Name="cardRoot"
            Padding="14,10,10,10"
            BorderBrush="#59FFFFFF"
            BorderThickness="1"
            CornerRadius="10">
            <Grid RowDefinitions="Auto,Auto,Auto">
                    <!--  标题 + 隐藏按钮  -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock
                            x:Name="titleText"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#E5202020"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="hideButton"
                            Grid.Column="1"
                            MinWidth="0"
                            Margin="10,0,0,0"
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="HideButton_Click"
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}" />
                    </Grid>
                    <!--  状态 + 进度条  -->
                    <StackPanel
                        x:Name="ProgressSection"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    x:Name="progressRing"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    IsActive="True" />
                                <TextBlock
                                    x:Name="statusText"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#D9202020"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                x:Name="percentText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#D9202020" />
                        </Grid>
                        <ProgressBar
                            x:Name="progressBar"
                            Maximum="100"
                            Minimum="0"
                            Value="0" />
                    </StackPanel>
                    <!--  结果 + 关闭按钮(完成态)  -->
                    <Grid
                        x:Name="ResultSection"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        ColumnDefinitions="*,Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                x:Name="resultIcon"
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                FontSize="14" />
                            <TextBlock
                                x:Name="resultText"
                                FontSize="12"
                                Foreground="#E5202020"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="closeButton"
                            Grid.Column="1"
                            MinWidth="0"
                            Margin="10,0,0,0"
                            Padding="10,2"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click"
                            FontSize="12"
                            Foreground="{ThemeResource SystemAccentColor}" />
                    </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
