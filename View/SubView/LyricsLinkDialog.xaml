<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.LyricsLinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CloseButtonText=""
    CornerRadius="10"
    mc:Ignorable="d">

    <!--  关联歌词: 顶部展示当前关联(可取消关联) + 插件搜索候选关联; 底部保留本地文件导入入口  -->
    <Grid MinWidth="460" MinHeight="320" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!--  当前歌曲  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="2">
            <TextBlock
                x:Name="SongTitleText"
                FontSize="15"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="SongArtistText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!--  已关联歌词卡片(无关联时不显示): 来源·标题 / 歌手·时长 + 取消关联  -->
        <Border
            x:Name="AssociationPanel"
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="12,10,4,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xE71B;" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="AssociatedTitleText"
                        FontSize="13"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="AssociatedSourceText"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="AssociatedSubText"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <HyperlinkButton
                    x:Name="UnlinkButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="UnlinkButton_Click" />
            </Grid>
        </Border>

        <!--  搜索行: 关键词 + 来源 + 搜索按钮  -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                KeyDown="SearchBox_KeyDown" />
            <ComboBox
                x:Name="SourceComboBox"
                Grid.Column="1"
                Margin="8,0,0,0"
                MinWidth="110"
                SelectionChanged="SourceComboBox_SelectionChanged" />
            <Button
                x:Name="SearchButton"
                Grid.Column="2"
                Margin="8,0,0,0"
                Click="SearchButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE721;" />
            </Button>
        </Grid>

        <!--  搜索结果  -->
        <ListView
            x:Name="ResultList"
            Grid.Row="4"
            MaxHeight="340"
            IsItemClickEnabled="True"
            ItemClick="ResultList_ItemClick"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LyricsCandidateItem">
                    <Grid ColumnDefinitions="*,Auto" Padding="4,6" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SubTitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  本地文件导入(保留原有功能)  -->
        <HyperlinkButton
            x:Name="ImportLocalButton"
            Grid.Row="5"
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Click="ImportLocalButton_Click"
            FontSize="12" />
    </Grid>
</ContentDialog>
