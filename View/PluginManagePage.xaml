<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.PluginManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginmodels="using:WinUIMusicPlayer.Services.Plugins"
    Loaded="PluginManagePage_Loaded"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!--  页面标题  -->
        <Grid Grid.Row="0">
            <TextBlock
                x:Uid="PluginManageTitle"
                Margin="16,10,0,10"
                FontSize="28" />
        </Grid>

        <!--  安装区  -->
        <StackPanel
            Grid.Row="1"
            Margin="16,8,16,8"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Command="{x:Bind ViewModel.InstallFromFileCommand}"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    <TextBlock x:Uid="PluginInstallFromFile" />
                </StackPanel>
            </Button>
            <Button Click="InstallFromUrl_Click" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE71B;" />
                    <TextBlock x:Uid="PluginInstallFromUrl" />
                </StackPanel>
            </Button>
            <Button
                Command="{x:Bind ViewModel.UninstallAllCommand}"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                    <TextBlock x:Uid="PluginUninstallAll" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  插件列表: 拖拽把手排序, 顺序决定在线搜索页 Tab 从左到右顺序  -->
        <ListView
            Grid.Row="2"
            Margin="16,4,16,0"
            HorizontalAlignment="Stretch"
            AllowDrop="True"
            CanReorderItems="True"
            DragItemsCompleted="PluginList_DragItemsCompleted"
            ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="pluginmodels:InstalledPluginItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,8">
                        <FontIcon
                            x:Uid="PluginDragHandle"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE700;" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Platform, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Author, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Status, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Version, Mode=OneWay}" />
                            <ToggleSwitch
                                MinWidth="0"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind Enabled, Mode=OneWay}"
                                Toggled="PluginToggle_Toggled" />
                            <HyperlinkButton
                                VerticalAlignment="Center"
                                Click="Uninstall_Click"
                                ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    <TextBlock x:Uid="PluginUninstall" />
                                </StackPanel>
                            </HyperlinkButton>
                            <Button
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,4">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="PluginInfoMenu" Click="PluginInfo_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE946;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="PluginUserVariablesMenu"
                                            Click="UserVariables_Click"
                                            IsEnabled="{x:Bind HasUserVariables, Mode=OneWay}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE713;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="PluginCheckUpdateMenu" Click="CheckUpdate_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE895;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
