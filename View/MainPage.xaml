<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    mc:Ignorable="d">

    <Grid>
        <Grid RowDefinitions="*,Auto">
            <Grid Grid.Row="0" Margin="0,32,0,0">
                <NavigationView
                    x:Name="NavigationViewControl"
                    BackRequested="NavigationViewControl_BackRequested"
                    IsBackButtonVisible="Visible"
                    IsBackEnabled="{x:Bind ViewModel.AppViewModel.IsBackBtnEnable, Mode=OneWay}"
                    IsPaneToggleButtonVisible="False"
                    ItemInvoked="NavigationView_ItemInvoked"
                    OpenPaneLength="160"
                    PaneDisplayMode="Left">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Tag="Home">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE80F;" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="Home" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Tag="OnlineSearch">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE721;" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="OnlineSearch" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Icon="Audio" Tag="MusicBrowse">
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="MusicBrowse" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Tag="MyPlayLists">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="MyPlayLists" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Icon="NewFolder" Tag="AddFolder">
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="AddFolder" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Tag="Stats">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="Stats" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Tag="PluginManage">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8F1;" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="PluginManage" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    <Frame x:Name="MainFrame" Background="Transparent" />
                </NavigationView>
            </Grid>

            <!--  右侧播放列表面板(点按底栏列表按钮从右侧滑出)  -->
            <Grid
                x:Name="CurrentPlayListOverlay"
                Grid.Row="0"
                Margin="0,32,0,0"
                Background="Transparent"
                Tapped="CurrentPlayListOverlay_Tapped"
                Visibility="Collapsed">
                <Grid
                    x:Name="CurrentPlayListPanel"
                    Width="340"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="8,0,0,0"
                    Tapped="CurrentPlayListPanel_Tapped">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.Background>
                        <AcrylicBrush
                            FallbackColor="{ThemeResource SolidBackgroundFillColorBase}"
                            TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                            TintOpacity="0.88" />
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  头部: 标题 + 数量 + 关闭  -->
                    <Grid
                        Grid.Row="0"
                        Padding="16,12,6,12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnDefinitions="*,Auto,Auto">
                        <TextBlock
                            x:Uid="PlayLists"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold" />
                        <TextBlock
                                        Grid.Column="1"
                                        Margin="8,2,12,2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingList.Count, Mode=OneWay}" />
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CurrentPlayListPanelCloseButton_Click">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="CurrentPlayListView"
                        Grid.Row="1"
                        Padding="0,0,0,8"
                        DoubleTapped="CurrentPlayListView_DoubleTapped"
                        ItemsSource="{x:Bind ViewModel.AppViewModel.CurrentPlayingList, Mode=OneWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Music">
                                <StackPanel Margin="2,6" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Author, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
            <Grid
                x:Name="BottomControlBar"
                Grid.Row="1"
                Height="120"
                Margin="10,0,10,10"
                Visibility="{x:Bind NavigationViewControl.Visibility, Mode=OneWay}"
                RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="0" ColumnDefinitions="*,Auto">
                    <Slider
                        x:Name="ProgressSlider"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        Loaded="ProgressSlider_Loaded"
                        Maximum="{x:Bind ViewModel.AppViewModel.ProgressSliderMax, Mode=TwoWay}"
                        Minimum="0"
                        PointerEntered="ProgressSlider_PointerEntered"
                        PointerExited="ProgressSlider_PointerExited"
                        ThumbToolTipValueConverter="{StaticResource AdvancedThumbToolTipValueConverter}"
                        Value="{x:Bind ViewModel.AppViewModel.ProgressSlider, Mode=TwoWay}" />
                    <TextBlock
                        x:Name="PlayTimeTextBlock"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.AppViewModel.PlayTimeText, Mode=OneWay}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0" ColumnDefinitions="*,Auto,*">
                    <Grid
                        x:Name="AlbumCoverAuthorTitleModel"
                        Grid.Column="0"
                        Margin="0"
                        ColumnDefinitions="Auto,*"
                        VerticalAlignment="Center"
                        Visibility="Visible">
                        <Button
                            x:Name="AlbumCoverImageBtn"
                            Margin="5,0,5,0"
                            Padding="0"
                            Grid.Column="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.AlbumCoverImageCommand, Mode=OneWay}"
                            CornerRadius="5"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource SimpleHoverButtonStyle}">
                            <Grid RowDefinitions="auto">
                                <Grid x:Name="AlbumCoverImageGrid" Grid.Row="0">
                                    <Grid
                                        x:Name="AlbumCoverImage"
                                        Width="80"
                                        Height="80"
                                        Canvas.ZIndex="1">
                                        <Image
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="UniformToFill">
                                            <interactivity:Interaction.Behaviors>
                                                <behaviors:FadeImageBehavior ImageHash="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundHash, Mode=OneWay}" Duration="00:00:1" />
                                            </interactivity:Interaction.Behaviors>
                                        </Image>
                                    </Grid>
                                    <Grid
                                        Width="80"
                                        Height="80"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        Canvas.ZIndex="0">
                                        <FontIcon
                                            Canvas.ZIndex="0"
                                            FontSize="40"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE93C;" />
                                    </Grid>
                                </Grid>

                                <FontIcon
                                    x:Name="AlbumCoverImageChevronUp"
                                    Grid.Row="0"
                                    Glyph="&#xE70E;"
                                    Opacity="0" />
                            </Grid>
                        </Button>
                        <Grid
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Height="80"
                            RowDefinitions="Auto,*,*,Auto">
                            <dev:AutoScrollView
                                Grid.Row="0"
                                Margin="10,0,10,0"
                                IsPlaying="False"
                                PointerCanceled="AutoScrollHover_PointerCanceled"
                                PointerEntered="AutoScrollHover_PointerEntered"
                                PointerExited="AutoScrollHover_PointerExited">
                                <TextBlock
                                    x:Name="MusicTitleTextBlock"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </dev:AutoScrollView>
                            <Button
                                x:Name="MusicAlbumButton"
                                Grid.Row="1"
                                Margin="10,0,10,0"
                                Padding="1"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.MusicBrowseVM.AlbumButtonCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}">
                                <Button.Content>
                                    <dev:AutoScrollView
                                        Margin="0"
                                        IsPlaying="False"
                                        PointerCanceled="AutoScrollHover_PointerCanceled"
                                        PointerEntered="AutoScrollHover_PointerEntered"
                                        PointerExited="AutoScrollHover_PointerExited">
                                        <TextBlock
                                            FontSize="12"
                                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                            TextTrimming="WordEllipsis" />
                                    </dev:AutoScrollView>
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="MusicAuthorButton"
                                Grid.Row="2"
                                Margin="10,0,10,0"
                                Padding="1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.MusicBrowseVM.ArtistButtonCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}">
                                <Button.Content>
                                    <dev:AutoScrollView
                                        Margin="0"
                                        IsPlaying="False"
                                        PointerCanceled="AutoScrollHover_PointerCanceled"
                                        PointerEntered="AutoScrollHover_PointerEntered"
                                        PointerExited="AutoScrollHover_PointerExited">
                                        <TextBlock
                                            FontSize="12"
                                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                            TextTrimming="WordEllipsis" />
                                    </dev:AutoScrollView>
                                </Button.Content>
                            </Button>
                            <Grid Grid.Row="3" VerticalAlignment="Bottom" ColumnDefinitions="Auto,Auto" Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.AppViewModel.IsCurrentMusicOnline), Mode=OneWay}">
                                <TextBlock
                                    x:Name="MusicInfoTextBlock"
                                    Grid.Column="0"
                                    Margin="10,0,10,0"
                                    FontSize="12"
                                    Text="{x:Bind ViewModel.AppViewModel.MusicInfo, Mode=OneWay}" />
                                <Border
                                    x:Name="HRImage"
                                    Grid.Column="1"
                                    Padding="4,0,4,1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#F7C8AC"
                                    CornerRadius="2"
                                    Visibility="{x:Bind tools:BindUtils.GetHrMusicVisibility(ViewModel.AppViewModel.CurrentPlayingMusic.SampleRate, ViewModel.AppViewModel.CurrentPlayingMusic.BitDepth), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="Bold"
                                        Foreground="#F98555"
                                        Text="HQ" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        RowDefinitions="Auto">

                        <Button
                            x:Name="PlayBarFavouriteButton"
                            Grid.Column="0"
                            Margin="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.UpdateFavouriteCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon Foreground="Red" Glyph="{x:Bind tools:BindUtils.FavouriteGlyphConverter(ViewModel.AppViewModel.CurrentPlayingMusic.IsFavorite), Mode=OneWay}" />
                        </Button>

                        <!--  添加到歌单按钮(收藏按钮与播放顺序按钮之间)  -->
                        <Button
                            x:Name="PlayBarAddToPlayListButton"
                            Grid.Column="1"
                            Margin="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="PlayBarAddToPlayListButton_Click"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="AddToMyPlayListToolTip" />
                            </ToolTipService.ToolTip>
                            <FontIcon FontFamily="{StaticResource MaterialDesignIconsFontFamily}" Glyph="&#xF0412;" />
                        </Button>

                        <Button
                            x:Name="PlayModeButton"
                            Grid.Column="2"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.PlayModeChangedCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="PlayModeIcon"
                                FontSize="18"
                                Glyph="{x:Bind tools:BindUtils.PlayModeToGlyphConverter(ViewModel.AppViewModel.CurrentPlayMode), Mode=OneWay}" />
                        </Button>

                        <Button
                            x:Name="LastMusicButton"
                            Grid.Column="3"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.LastMusicButtonChangedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentPlayListExist(ViewModel.AppViewModel.CurrentPlayingList), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="22" Glyph="&#xF8AC;" />
                        </Button>

                        <Button
                            x:Name="PlayPauseButton"
                            Grid.Column="4"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.PlayButtonChangedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsPlayControlEnabled(ViewModel.AppViewModel.IsResolvingSource, ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource PlayButtonStyle}">
                            <Grid>
                                <ProgressRing
                                    Width="34"
                                    Height="34"
                                    IsActive="{x:Bind ViewModel.AppViewModel.IsResolvingSource, Mode=OneWay}"
                                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.AppViewModel.IsResolvingSource), Mode=OneWay}" />
                                <FontIcon
                                    Width="45"
                                    Height="45"
                                    FontSize="30"
                                    Glyph="{x:Bind tools:BindUtils.PlayStatusToGlyphConverter(ViewModel.AppViewModel.IsPlaying), Mode=OneWay}"
                                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.AppViewModel.IsResolvingSource), Mode=OneWay}" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NextMusicButton"
                            Grid.Column="5"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.NextMusicButtonChangedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentPlayListExist(ViewModel.AppViewModel.CurrentPlayingList), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="22" Glyph="&#xF8AD;" />
                        </Button>

                        <Button
                            x:Name="LyricsOffsetButton"
                            Grid.Column="6"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xE916;" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Width="280" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock
                                                x:Uid="LyricsTimeOffsetTag"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind tools:BindUtils.LyricsOffsetTextConverter(ViewModel.AppViewModel.CurrentPlayingMusic.LyricsOffsetMs), Mode=OneWay}" />
                                        </Grid>
                                        <Slider
                                            Maximum="10000"
                                            Minimum="-10000"
                                            SnapsTo="Ticks"
                                            TickFrequency="100"
                                            Value="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.LyricsOffsetMs, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="-10s" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="0" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="+10s" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="LyricsTimeOffset" />
                            </ToolTipService.ToolTip>
                        </Button>

                        <Button
                            x:Name="DownloadButton"
                            Grid.Column="7"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="DownloadButton_Click"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.IsCurrentMusicOnline, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xE896;" />
                        </Button>
                    </Grid>
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  播放音质选择(音量按钮左侧): 弹出 128k/320k/flac/flac24bit 单选菜单, 持久化为默认音质  -->
                        <Button
                            x:Name="PlayQualityButton"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                FontSize="18"
                                FontFamily="{StaticResource MaterialDesignIconsFontFamily}"
                                Glyph="&#xF07CF;" />
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="PlayQualityToolTip" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button
                            x:Name="VolumeButton"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            PointerWheelChanged="VolumeButton_PointerWheelChanged"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="VolumeSliderIcon"
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Glyph="{x:Bind tools:BindUtils.VolumeToGlyphConverter(ViewModel.AppViewModel.Volume), Mode=OneWay}" />
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ViewModel.AppViewModel.VolumeSliderIconButtonChangedCommand, Mode=OneWay}">
                                            <FontIcon
                                                x:Name="VolumeInsideSliderIcon"
                                                Grid.Column="0"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Glyph="{x:Bind tools:BindUtils.VolumeToGlyphConverter(ViewModel.AppViewModel.Volume), Mode=OneWay}" />
                                        </Button>
                                        <Slider
                                            x:Name="VolumeSlider"
                                            Grid.Column="1"
                                            Width="150"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            PointerEntered="VolumeSlider_PointerEntered"
                                            PointerExited="VolumeSlider_PointerExited"
                                            PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                            Value="{x:Bind ViewModel.AppViewModel.Volume, Mode=TwoWay}" />
                                        <TextBlock
                                            Width="30"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ViewModel.AppViewModel.Volume, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind ViewModel.AppViewModel.Volume, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button
                            x:Name="CurrentPlayListButton"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="CurrentPlayListButton_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon x:Name="CurrentPlayListIcon" Glyph="&#xE90B;" />
                        </Button>
                        <Button
                            x:Name="EqualizerButton"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.EqualizerButtonCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon x:Name="EqualizerIcon" Glyph="&#xE9E9;" />
                        </Button>
                        <Button
                            x:Name="DesktopLyricsButton"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="DesktopLyricsButton_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="DesktopLyricsIcon"
                                Glyph="&#xE8C1;"
                                Opacity="{x:Bind tools:BindUtils.DesktopLyricsButtonOpacity(ViewModel.DesktopLyrics.IsEnabled), Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Frame x:Name="PlayingFrame" Visibility="Collapsed" />
        <Grid
            x:Name="AppTitleBar"
            Height="40"
            Margin="0"
            Padding="0"
            VerticalAlignment="Top"
            Background="Transparent"
            PointerEntered="AppTitleBar_PointerEntered"
            PointerExited="AppTitleBar_PointerExited"
            ColumnDefinitions="Auto,*,Auto,Auto">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <StackPanel
                Grid.Column="0"
                Margin="15,0,0,0"
                Opacity="{x:Bind tools:BindUtils.VisibilityToOpacityConverter(NavigationViewControl.Visibility), Mode=OneWay}"
                Orientation="Horizontal">
                <Image
                    x:Name="AppLogo"
                    Width="18"
                    Height="18"
                    Margin="0,2,0,0"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/icon.ico" />
                <TextBlock
                    x:Uid="AppTitle"
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    IsHitTestVisible="False"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <Button
                x:Name="CancelPlayingDetailButton"
                Grid.Column="0"
                Margin="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="CancelPlayingDetailButton_Click"
                Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.AppViewModel.IsPointerOverTitleBar), Mode=OneWay}"
                Style="{StaticResource TitleBarButtonStyle}"
                Visibility="{x:Bind ViewModel.AppViewModel.IsPlayingDetailVisible, Mode=OneWay}">
                <Button.OpacityTransition>
                    <ScalarTransition />
                </Button.OpacityTransition>
                <FontIcon FontSize="18" Glyph="&#xE70D;" />
            </Button>
            <!--  顶栏账号入口: 未登录人形图标 / 登录后头像; 播放详情页时隐藏(该页顶栏仅保留返回与窗口控制)  -->
            <Button
                x:Name="AccountAvatarButton"
                Grid.Column="2"
                Margin="0,0,8,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="AccountAvatarButton_Click"
                CornerRadius="16"
                Style="{StaticResource TitleBarButtonStyle}"
                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.AppViewModel.IsPlayingDetailVisible), Mode=OneWay}">
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <TextBlock x:Name="AccountAvatarToolTipText" />
                    </ToolTip>
                </ToolTipService.ToolTip>
                <Grid Width="28" Height="28" CornerRadius="14">
                    <!--  未登录: 人形图标  -->
                    <Ellipse
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <FontIcon
                        x:Name="AccountAvatarPlaceholderIcon"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE77B;" />
                    <!--  已登录: 头像  -->
                    <Ellipse
                        x:Name="AccountAvatarEllipse"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                        StrokeThickness="1"
                        Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Button>
            <StackPanel
                x:Name="TopRightButtons"
                Grid.Column="3"
                Margin="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.AppViewModel.IsPointerOverTitleBar), Mode=OneWay}"
                Orientation="Horizontal">
                <StackPanel.OpacityTransition>
                    <ScalarTransition />
                </StackPanel.OpacityTransition>
                <Button
                    x:Name="FullscreenTitleBarButton"
                    x:Uid="FullscreenTitleBarButton"
                    Click="FullscreenTitleBarButton_Click"
                    Style="{StaticResource TitleBarButtonStyle}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="{x:Bind tools:BindUtils.FullScreenGlyphConverter(ViewModel.AppViewModel.IsFullScreen), Mode=OneWay}" />
                </Button>
                <Button
                    x:Name="MinimizeButton"
                    x:Uid="MinimizeButton"
                    Click="MinimizeButton_Click"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.AppViewModel.IsFullScreen), Mode=OneWay}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE738;" />
                </Button>
                <Button
                    x:Name="MaximizeButton"
                    x:Uid="MaximizeButton"
                    Click="MaximizeButton_Click"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.AppViewModel.IsFullScreen), Mode=OneWay}">
                    <Grid>
                        <FontIcon
                            x:Name="EnterMaximizeFontIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE71A;"
                            Opacity="{x:Bind tools:BindUtils.BoolToOpacityReConverter(ViewModel.AppViewModel.IsMaximized), Mode=OneWay}">
                            <FontIcon.OpacityTransition>
                                <ScalarTransition />
                            </FontIcon.OpacityTransition>
                        </FontIcon>
                        <FontIcon
                            x:Name="ExitMaximizeFontIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE744;"
                            Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.AppViewModel.IsMaximized), Mode=OneWay}">
                            <FontIcon.OpacityTransition>
                                <ScalarTransition />
                            </FontIcon.OpacityTransition>
                        </FontIcon>
                    </Grid>
                </Button>
                <Button
                    x:Name="CloseTitleBarButton"
                    x:Uid="CloseTitleBarButton"
                    Click="CloseTitleBarButton_Click"
                    Style="{StaticResource TitleBarCloseButtonStyle}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
