<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.OnlineSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:vm="using:WinUIMusicPlayer.ViewModel.Pages"
    Loaded="OnlineSearchPage_Loaded"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!--  搜索页自身内容容器: 歌手作品页打开时整体隐藏, 返回时恢复, 避免透明重叠  -->
        <Grid
            x:Name="ContentRoot"
            Grid.Row="0"
            Grid.RowSpan="6"
            RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!--  页面标题  -->
        <Grid Grid.Row="0">
            <TextBlock
                x:Uid="OnlineSearch"
                Margin="16,10,0,10"
                FontSize="28" />
        </Grid>

        <!--  搜索框  -->
        <Grid
            Grid.Row="1"
            Margin="16,8,16,8"
            ColumnDefinitions="*,Auto">
            <TextBox
                x:Name="KeywordBox"
                Grid.Column="0"
                VerticalAlignment="Center"
                KeyDown="KeywordBox_KeyDown"
                PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                Text="{x:Bind ViewModel.Keyword, Mode=TwoWay}" />
            <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Padding="16,6"
                Click="SearchButton_Click"
                IsEnabled="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                    <TextBlock x:Uid="OnlineSearchButton" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  一级搜索类型 Tab(歌曲/歌手/歌单/专辑)  -->
        <ScrollViewer
            Grid.Row="2"
            Margin="16,2,16,0"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Disabled"
            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.NoPlugins), Mode=OneWay}">
            <ListView
                x:Name="SearchTypeTabs"
                IsItemClickEnabled="True"
                ItemClick="SearchTypeTab_Click"
                ItemsSource="{x:Bind ViewModel.SearchTypes, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchTypeTab">
                        <Grid Padding="10,6,10,4">
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                <!--  选中下划线指示器: 外层固定高度占位, 避免选中/未选中项高度跳变  -->
                                <Grid Height="3">
                                    <Border
                                        Height="2.5"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="1.5"
                                        Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(IsSelected), Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!--  插件 Tab(收紧)  -->
        <ScrollViewer
            Grid.Row="3"
            Margin="16,0,16,2"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Disabled"
            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.NoPlugins), Mode=OneWay}">
            <ListView
                x:Name="PluginTabs"
                IsItemClickEnabled="True"
                ItemClick="PluginTab_Click"
                ItemsSource="{x:Bind ViewModel.AvailablePlugins, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginTab">
                        <Grid Padding="7,3,7,2">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Name}" />
                                <!--  选中下划线指示器: 外层固定高度占位, 避免选中/未选中项高度跳变  -->
                                <Grid Height="2">
                                    <Border
                                        Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="1"
                                        Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(IsSelected), Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!--  歌曲列表(歌曲模式 + 目录详情模式共用)  -->
        <Grid
            Grid.Row="4"
            RowDefinitions="Auto,*"
            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.IsCatalogVisible), Mode=OneWay}">
            <!--  目录详情头部: 返回 + 标题/副标题  -->
            <Grid
                Grid.Row="0"
                Margin="16,4,16,2"
                ColumnDefinitions="Auto,*,Auto"
                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsDetailMode), Mode=OneWay}">
                <Button
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="6,4"
                    Command="{x:Bind ViewModel.BackFromDetailCommand, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <ListView
                Grid.Row="1"
                Margin="16,4,16,0"
                HorizontalAlignment="Stretch"
                DoubleTapped="ResultList_DoubleTapped"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OnlineSongItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="4,4">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4">
                                <Grid>
                                    <!--  无封面占位  -->
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Glyph="&#xE8D6;" />
                                    <!--  封面: ArtworkHash 有值后由 FadeImageBehavior 淡入  -->
                                    <Image Stretch="UniformToFill">
                                        <interactivity:Interaction.Behaviors>
                                            <behaviors:FadeImageBehavior ImageHash="{x:Bind ArtworkHash, Mode=OneWay}" Duration="00:00:0.3" />
                                        </interactivity:Interaction.Behaviors>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Artist, Mode=OneWay}" />
                                    <Run Text=" — " />
                                    <Run Text="{x:Bind Album, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run Text="{x:Bind Platform, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind DurationText, Mode=OneWay}" />
                            <!--  ⋯ 菜单: 播放 / 添加到歌单  -->
                            <Button
                                Grid.Column="3"
                                Padding="8,4"
                                IsEnabled="{x:Bind IsResolving, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="OnlineItemPlay"
                                            Click="PlayButton_Click"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="OnlineItemAddToPlayList"
                                            Click="AddToPlayListMenu_Click"
                                            Tag="{x:Bind}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource MaterialDesignIconsFontFamily}" Glyph="&#xF0412;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  目录列表(歌手/专辑/歌单搜索结果), 点击进入详情  -->
        <ListView
            Grid.Row="4"
            Margin="16,4,16,0"
            HorizontalAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="CatalogList_ItemClick"
            ItemsSource="{x:Bind ViewModel.CatalogResults, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsCatalogVisible), Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogEntryItem">
                    <Grid ColumnDefinitions="Auto,*" Padding="4,4">
                        <Border
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="6">
                            <Grid>
                                <!--  无封面占位(按类型: 人物/音乐/列表)  -->
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind TypeGlyph}" />
                                <!--  封面: ArtworkHash 有值后由 FadeImageBehavior 淡入  -->
                                <Image Stretch="UniformToFill">
                                    <interactivity:Interaction.Behaviors>
                                        <behaviors:FadeImageBehavior ImageHash="{x:Bind ArtworkHash, Mode=OneWay}" Duration="00:00:0.3" />
                                    </interactivity:Interaction.Behaviors>
                                </Image>
                            </Grid>
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Subtitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  空白态: 条状搜索历史, 一横条一横条。
            必须位于结果列表之后(层级在上): 空列表的透明背景仍会拦截点击, 放在前面会导致历史条不可点 -->
        <ScrollViewer
            Grid.Row="4"
            Margin="16,12,16,0"
            Visibility="{x:Bind ViewModel.ShowHistory, Mode=OneWay}">
            <StackPanel>
                <Grid
                    Margin="0,0,0,4"
                    ColumnDefinitions="*,Auto">
                    <TextBlock
                        x:Uid="OnlineSearchHistory"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton
                        x:Uid="OnlineSearchClearHistory"
                        Grid.Column="1"
                        Padding="8,2"
                        Command="{x:Bind ViewModel.ClearHistoryCommand, Mode=OneWay}" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.SearchHistory, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button
                                Margin="0,0,0,6"
                                Padding="14,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Click="HistoryChip_Click"
                                CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE823;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind}"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE721;" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!--  底部: 加载更多  -->
        <Grid
            Grid.Row="5"
            Margin="16,8,16,12"
            ColumnDefinitions="Auto,*">
            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.LoadMoreCommand, Mode=OneWay}"
                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.CanLoadMore), Mode=OneWay}">
                <TextBlock x:Uid="OnlineSearchMore" />
            </Button>
            <ProgressRing
                Grid.Column="0"
                Width="22"
                Height="22"
                Margin="16,0,0,0"
                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsSearching), Mode=OneWay}" />
        </Grid>

        </Grid>

        <!--  歌手作品页承载 Frame: 点击歌手条目时钻入显示 OnlineArtistPage(独立新页面, 仿歌单详情)  -->
        <Frame
            x:Name="ArtistFrame"
            Grid.Row="0"
            Grid.RowSpan="6"
            Visibility="Collapsed" />
    </Grid>
</Page>
