<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MyPlayListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:vm="using:WinUIMusicPlayer.ViewModel.Pages"
    mc:Ignorable="d">

    <Grid>
        <!--  歌单列表(进入详情时整体隐藏, 返回时恢复)  -->
        <Grid x:Name="ListRoot" RowDefinitions="Auto,*">
            <Grid
                Grid.Row="0"
                Margin="16,10,16,10"
                ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="MyPlayLists"
                        VerticalAlignment="Center"
                        FontSize="28" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.PlayLists.Count, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="PlayListPageCountSuffix"
                            Margin="4,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="RemoveAllPlayLists_Click"
                        Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.IsEmpty), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                            <TextBlock
                                x:Uid="MyPlayListDeleteAll"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="CreatePlayList_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock
                                x:Uid="MyPlayListNew"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  空态  -->
            <Grid Grid.Row="1" Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsEmpty), Mode=OneWay}">
                <StackPanel
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="28">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE93C;" />
                    </Border>
                    <TextBlock
                        x:Uid="MyPlayListEmptyTitle"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Uid="MyPlayListEmptySubtitle"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Click="CreatePlayList_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock
                                x:Uid="MyPlayListNew"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  歌单条状列表: 全宽圆角卡片条(左封面 + 中间歌单名/曲目数 + 右侧⋯菜单)  -->
            <ListView
                Grid.Row="1"
                Margin="16,0,16,10"
                IsItemClickEnabled="True"
                ItemClick="PlayListGridView_ItemClick"
                ItemsSource="{x:Bind ViewModel.PlayLists, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.IsEmpty), Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MyPlayListItem">
                        <Grid
                            Padding="10,8,12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            ColumnDefinitions="Auto,*,Auto"
                            CornerRadius="8"
                            PointerEntered="OnCoverPointerEntered"
                            PointerExited="OnCoverPointerExited">
                            <!--  左侧封面  -->
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="2,0,12,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <Grid>
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE93C;" />
                                    <Border CornerRadius="6">
                                        <Image Stretch="UniformToFill">
                                            <interactivity:Interaction.Behaviors>
                                                <behaviors:FadeImageBehavior ImageHash="{x:Bind CoverHash, Mode=OneWay}" Duration="00:00:0.3" />
                                            </interactivity:Interaction.Behaviors>
                                        </Image>
                                    </Border>
                                </Grid>
                            </Border>
                            <!--  中间: 歌单名 + 曲目数  -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    Text="{x:Bind PlayList.Name, Mode=OneWay}"
                                    TextAlignment="Left"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind PlayList.SongCount, Mode=OneWay}" />
                                    <TextBlock
                                        x:Uid="MyPlayListSongCountSuffix"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <!--  右侧: ⋯ 菜单(重命名/删除, 悬停显示)  -->
                            <Button
                                x:Name="MoreBtn"
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                Style="{StaticResource CircularButtonStyle}"
                                Tag="{x:Bind PlayList}"
                                Visibility="Collapsed">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Uid="Edit"
                                            Click="EditPlayListNameButton_Click"
                                            Tag="{x:Bind PlayList}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Uid="MyPlayListDelete"
                                            Click="RemovePlayListButton_Click"
                                            Tag="{x:Bind PlayList}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xECC9;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  在线歌单详情承载 Frame: 点击歌单钻入, 返回恢复列表  -->
        <Frame
            x:Name="DetailFrame"
            Visibility="Collapsed" />
    </Grid>
</Page>
