<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.PlayingDetailPage"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:aic="using:AnimatedWin2dControls.Controls.AlbumImgControl"
    xmlns:atb="using:AnimatedWin2dControls.Controls.AnimatedTextBlock"
    xmlns:awc="using:AnimatedWin2dControls.Controls"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:lyrics="using:WinUIMusicPlayer.Controls.Lyrics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:uc="using:WinUIMusicPlayer.Controls"
    mc:Ignorable="d">

    <Grid>
        <awc:NowPlayingCanvas
            x:Name="NowPlaying"
            x:Load="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneTime}"
            BackgroundShaderIndex="{x:Bind ViewModel.AppViewModel.BackgroundShaderIndex, Mode=OneWay}"
            EnableAdvancedLyrics="{x:Bind ViewModel.AppViewModel.EnableAdvancedLyricsEffect, Mode=OneTime}"
            EnableLightWave="{x:Bind ViewModel.AppViewModel.EnableLightWave, Mode=OneWay}"
            ExceptionOccurred="BackGround_ExceptionOccurred"
            IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
            IsFogEnabled="{x:Bind ViewModel.AppViewModel.IsFogEffectEnabled, Mode=OneWay}"
            IsRaindropEnabled="{x:Bind ViewModel.AppViewModel.IsRaindropEffectEnabled, Mode=OneWay}"
            IsSnowEnabled="{x:Bind ViewModel.AppViewModel.IsSnowEffectEnabled, Mode=OneWay}"
            LyricLineClicked="NowPlaying_LyricLineClicked"
            RenderError="LyricsView_ExceptionInteracted"
            ThemeResolved="BackGround_ThemeResolved"
            UseImageDominantTheme="{x:Bind ViewModel.AppViewModel.UseImageDominantTheme, Mode=OneWay}" />
        <Grid x:Name="PlayingDetail" Margin="0" ColumnDefinitions="*,*">
            <Grid
                x:Name="LeftControlPanel"
                Grid.Column="0"
                Margin="0"
                ColumnDefinitions="*,4*,*"
                RowDefinitions="*,6*,Auto,50,*">
                <Grid
                    x:Name="CoverContainer"
                    Grid.Row="1"
                    Grid.Column="1">
                    <Grid
                        x:Name="PlayingDetailAlbumCoverImageGrid"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        x:Load="{x:Bind tool:BindUtils.BoolToBoolReConverter(ViewModel.AppViewModel.IsWin2dCoverImageControlEnable), Mode=OneTime}">
                        <uc:ImageSwitcher
                            CornerRadiusAmount="12"
                            ImageHash="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundHash, Mode=OneWay}"
                            IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
                            ShadowAmount="16"
                            SwitchType="{x:Bind model:AppSettings.ImageSwitchType, Mode=OneWay}" />
                    </Grid>
                    <aic:AlbumArtControl
                        x:Name="AlbumArtControl"
                        Margin="0"
                        x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dCoverImageControlEnable, Mode=OneTime}"
                        ImageHash="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundHash, Mode=OneWay}"
                        IsActive="{x:Bind ViewModel.AppViewModel.IsWin2dCoverImageControlEnable, Mode=OneTime}"
                        IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
                        IsShadowEnabled="True" />
                </Grid>
                <Grid
                    x:Name="AnimatedTextBlock"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="20,0,20,0"
                    RowDefinitions="Auto,Auto,Auto">
                    <!--  标题行: 标题 + 收藏按钮(歌名右侧), 整体跟随歌词对齐方式  -->
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="Auto,Auto,Auto"
                        HorizontalAlignment="{x:Bind tools:BindUtils.TextAlignmentToHorizontalAlignmentConverter(ViewModel.AppViewModel.EffectivePlayingDetailAlignment), Mode=OneWay}">
                        <atb:AnimatedTextBlock
                            x:Name="AnimatedPlayingDetailTitleTextBlock"
                            Margin="0"
                            x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=OneTime}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                            TextAlignment="{x:Bind ViewModel.AppViewModel.EffectivePlayingDetailAlignment, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <dev:AutoScrollView
                            Grid.Column="0"
                            Margin="0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            IsPlaying="False"
                            PointerCanceled="AutoScrollHover_PointerCanceled"
                            PointerEntered="AutoScrollHover_PointerEntered"
                            PointerExited="AutoScrollHover_PointerExited">
                            <TextBlock
                                x:Name="PlayingDetailTitleTextBlock"
                                Margin="0"
                                FontSize="{x:Bind ViewModel.TitleFontSize, Mode=OneWay}"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                Opacity="{x:Bind tool:BindUtils.BoolToOpacityReConverter(ViewModel.AppViewModel.IsWin2dAnimatedText), Mode=OneTime}"
                                Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                                TextAlignment="{x:Bind ViewModel.AppViewModel.EffectivePlayingDetailAlignment, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </dev:AutoScrollView>
                        <Button
                            x:Name="TitleFavouriteButtonPlayingDetail"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.UpdateFavouriteCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                FontSize="20"
                                Foreground="Red"
                                Glyph="{x:Bind tools:BindUtils.FavouriteGlyphConverter(ViewModel.AppViewModel.CurrentPlayingMusic.IsFavorite), Mode=OneWay}" />
                        </Button>
                        <!--  添加到歌单按钮(收藏按钮右侧): 收入在线歌单(仅存插件链接, 无需下载)  -->
                        <Button
                            x:Name="TitleAddToPlayListButtonPlayingDetail"
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="TitleAddToPlayListButton_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="AddToMyPlayListToolTip" />
                            </ToolTipService.ToolTip>
                            <FontIcon FontFamily="{StaticResource MaterialDesignIconsFontFamily}" FontSize="26" Glyph="&#xF0412;" />
                        </Button>
                    </Grid>
                    <atb:AnimatedTextBlock
                        x:Name="AnimatedPlayingDetailAlbumArtistTextBlock"
                        Grid.Row="1"
                        Margin="0,0,0,1"
                        x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=OneTime}"
                        FontSize="24"
                        FontWeight="Normal"
                        Opacity="0.8"
                        Text="{x:Bind tool:BindUtils.MusicToInfo(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                        TextAlignment="{x:Bind ViewModel.AppViewModel.EffectivePlayingDetailAlignment, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,2"
                        Opacity="{x:Bind tool:BindUtils.BoolToOpacityRe08Converter(ViewModel.AppViewModel.IsWin2dAnimatedText), Mode=OneTime}">
                        <dev:AutoScrollView
                            Margin="0"
                            Padding="0"
                            HorizontalAlignment="{x:Bind tools:BindUtils.TextAlignmentToHorizontalAlignmentConverter(ViewModel.AppViewModel.EffectivePlayingDetailAlignment), Mode=OneWay}"
                            IsPlaying="False"
                            PointerCanceled="AutoScrollHover_PointerCanceled"
                            PointerEntered="AutoScrollHover_PointerEntered"
                            PointerExited="AutoScrollHover_PointerExited">
                            <TextBlock
                                x:Name="PlayingDetailAlbumTextBlock"
                                Margin="0"
                                FontSize="{x:Bind ViewModel.ArtistAlbumFontSize, Mode=OneWay}"
                                FontWeight="Normal"
                                IsTextSelectionEnabled="True"
                                Opacity="{x:Bind tool:BindUtils.BoolToOpacityReConverter(ViewModel.AppViewModel.IsWin2dAnimatedText), Mode=OneTime}"
                                Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                TextAlignment="{x:Bind ViewModel.AppViewModel.EffectivePlayingDetailAlignment, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </dev:AutoScrollView>
                        <dev:AutoScrollView
                            Margin="0"
                            Padding="0"
                            HorizontalAlignment="{x:Bind tools:BindUtils.TextAlignmentToHorizontalAlignmentConverter(ViewModel.AppViewModel.EffectivePlayingDetailAlignment), Mode=OneWay}"
                            IsPlaying="False"
                            PointerCanceled="AutoScrollHover_PointerCanceled"
                            PointerEntered="AutoScrollHover_PointerEntered"
                            PointerExited="AutoScrollHover_PointerExited">
                            <TextBlock
                                x:Name="PlayingDetailArtistTextBlock"
                                Margin="0"
                                FontSize="{x:Bind ViewModel.ArtistAlbumFontSize, Mode=OneWay}"
                                FontWeight="Normal"
                                IsTextSelectionEnabled="True"
                                Opacity="{x:Bind tool:BindUtils.BoolToOpacityReConverter(ViewModel.AppViewModel.IsWin2dAnimatedText), Mode=OneTime}"
                                Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                TextAlignment="{x:Bind ViewModel.AppViewModel.EffectivePlayingDetailAlignment, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </dev:AutoScrollView>
                    </StackPanel>
                    <StackPanel
                        x:Name="PlayingDetailInfoPanel"
                        Grid.Row="2"
                        Margin="0,0,0,5"
                        HorizontalAlignment="{x:Bind tools:BindUtils.TextAlignmentToHorizontalAlignmentConverter(ViewModel.AppViewModel.EffectivePlayingDetailAlignment), Mode=OneWay}"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{x:Bind tools:BindUtils.MusicInfoVisibilityConverter(ViewModel.AppViewModel.IsMusicInfoVisible, ViewModel.AppViewModel.IsCurrentMusicOnline), Mode=OneWay}">
                        <TextBlock
                            x:Name="PlayingDetailMusicInfoTextBlock"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="{x:Bind ViewModel.InfoFontSize, Mode=OneWay}"
                            Text="{x:Bind ViewModel.AppViewModel.MusicInfo, Mode=OneWay}" />
                        <Border
                            x:Name="PlayingDetailHRImage"
                            Padding="4,0,4,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#F7C8AC"
                            CornerRadius="2"
                            Visibility="{x:Bind tool:BindUtils.GetHrMusicVisibility(ViewModel.AppViewModel.CurrentPlayingMusic.SampleRate, ViewModel.AppViewModel.CurrentPlayingMusic.BitDepth), Mode=OneWay}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{x:Bind tool:BindUtils.GetHrMusicFontSize(ViewModel.InfoFontSize), Mode=OneWay}"
                                FontWeight="Bold"
                                Foreground="#F98555"
                                Text="HQ" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid
                x:Name="LyricsRegionHost"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,40,0,40"
                SizeChanged="LyricsRegionHost_SizeChanged">
                <lyrics:LyricsControl
                    x:Name="LyricsView"
                    x:Load="{x:Bind tool:BindUtils.IsLyricsControlEnabled(ViewModel.AppViewModel.IsFluidBackgroundEnabled, ViewModel.AppViewModel.EnableAdvancedLyricsEffect), Mode=OneTime}"
                    EnableAdvancedLyrics="{x:Bind ViewModel.AppViewModel.EnableAdvancedLyricsEffect, Mode=OneTime}"
                    ExceptionInteracted="LyricsView_ExceptionInteracted"
                    LyricInteracted="LyricsView_LyricInteracted"
                    LyricsMargin="{x:Bind ViewModel.AppViewModel.LyricsMargin, Mode=OneWay}" />
            </Grid>
        </Grid>
        <StackPanel
            x:Name="ControlsStack"
            Height="100"
            Margin="16,0,16,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Opacity="{x:Bind ViewModel.AppViewModel.ControlsStackOpacity, Mode=OneWay}"
            PointerEntered="ControlsStack_PointerEntered"
            PointerExited="ControlsStack_PointerExited">
            <StackPanel.OpacityTransition>
                <ScalarTransition />
            </StackPanel.OpacityTransition>
            <Grid x:Name="PlayingDetailControlBar" RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" Margin="0" ColumnDefinitions="*,Auto">
                    <Slider
                        x:Name="ProgressSliderPlayingDetail"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        Loaded="ProgressSliderPlayingDetail_Loaded"
                        Maximum="{x:Bind ViewModel.AppViewModel.ProgressSliderMax, Mode=TwoWay}"
                        Minimum="0"
                        PointerEntered="ProgressSlider_PointerEntered"
                        PointerExited="ProgressSlider_PointerExited"
                        ThumbToolTipValueConverter="{StaticResource AdvancedThumbToolTipValueConverter}"
                        Value="{x:Bind ViewModel.AppViewModel.ProgressSlider, Mode=TwoWay}" />
                    <TextBlock
                        x:Name="PlayTimeTextBlockPlayingDetail"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{x:Bind ViewModel.AppViewModel.PlayTimeText, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="1" Margin="0" ColumnDefinitions="*,Auto,*">
                    <StackPanel
                        Grid.Column="0"
                        Margin="10,0"
                        Orientation="Horizontal">
                        <Button
                            x:Name="SettingsButton"
                            Margin="5"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="SettingsButton_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Glyph="&#xE713;" />
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="SettingsContent" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button
                            x:Name="EqualizerButtonPlayingDetail"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="EqualizerButton_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="EqualizerIconPlayingDetail"
                                FontSize="18"
                                Glyph="&#xE9E9;" />
                        </Button>
                    </StackPanel>
                    <Grid
                        Grid.Column="1"
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        RowDefinitions="Auto">
                        <Button
                            x:Name="LinkLyricsButtonPlayingDetail"
                            Grid.Column="0"
                            Margin="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="LinkLyricsButtonPlayingDetail_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xE71B;" />
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="LinkLyrics" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button
                            x:Name="PlayModeButtonPlayingDetail"
                            Grid.Column="1"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.PlayModeChangedCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="PlayModeIconPlayingDetail"
                                FontSize="18"
                                Glyph="{x:Bind tools:BindUtils.PlayModeToGlyphConverter(ViewModel.AppViewModel.CurrentPlayMode), Mode=OneWay}" />
                        </Button>
                        <Button
                            x:Name="LastMusicButtonPlayingDetail"
                            Grid.Column="2"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.LastMusicButtonChangedCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xF8AC;" />
                        </Button>

                        <Button
                            x:Name="PlayPauseButtonPlayingDetail"
                            Grid.Column="3"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.PlayButtonChangedCommand, Mode=OneWay}"
                            Style="{StaticResource PlayButtonStyle}">
                            <FontIcon
                                Width="32"
                                Height="32"
                                FontSize="26"
                                Glyph="{x:Bind tools:BindUtils.PlayStatusToGlyphConverter(ViewModel.AppViewModel.IsPlaying), Mode=OneWay}" />
                        </Button>
                        <Button
                            x:Name="NextMusicButtonPlayingDetail"
                            Grid.Column="4"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.NextMusicButtonChangedCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xF8AD;" />
                        </Button>
                        <Button
                            x:Name="LyricsOffsetButtonPlayingDetail"
                            Grid.Column="5"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xE916;" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Width="280" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock
                                                x:Uid="LyricsTimeOffsetTag"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind tools:BindUtils.LyricsOffsetTextConverter(ViewModel.AppViewModel.CurrentPlayingMusic.LyricsOffsetMs), Mode=OneWay}" />
                                        </Grid>
                                        <Slider
                                            Maximum="10000"
                                            Minimum="-10000"
                                            SnapsTo="Ticks"
                                            TickFrequency="100"
                                            Value="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.LyricsOffsetMs, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="-10s" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="0" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="+10s" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <ToolTipService.ToolTip>
                                <ToolTip x:Uid="LyricsTimeOffset" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button
                            x:Name="DownloadButtonPlayingDetail"
                            Grid.Column="6"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="DownloadButtonPlayingDetail_Click"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.IsCurrentMusicOnline, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xE896;" />
                        </Button>
                    </Grid>
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="CurrentPlayListButtonPlayingDetail"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="CurrentPlayListButtonPlayingDetail_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="CurrentPlayListIconPlayingDetail"
                                FontSize="18"
                                Glyph="&#xE90B;" />
                        </Button>
                        <Button
                            x:Name="VolumePlayingDetailBtn"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            PointerWheelChanged="VolumeButton_PointerWheelChanged"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="VolumeSliderIconPlayingDetail"
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Glyph="{x:Bind tools:BindUtils.VolumeToGlyphConverter(ViewModel.AppViewModel.Volume), Mode=OneWay}" />
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ViewModel.AppViewModel.VolumeSliderIconButtonChangedCommand, Mode=OneWay}">
                                            <FontIcon
                                                x:Name="VolumeInsideSliderIcon"
                                                Grid.Column="0"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Glyph="{x:Bind tools:BindUtils.VolumeToGlyphConverter(ViewModel.AppViewModel.Volume), Mode=OneWay}" />
                                        </Button>
                                        <Slider
                                            x:Name="VolumeSliderPlayingDetail"
                                            Width="100"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            PointerEntered="VolumeSlider_PointerEntered"
                                            PointerExited="VolumeSlider_PointerExited"
                                            PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                            Value="{x:Bind ViewModel.AppViewModel.Volume, Mode=TwoWay}" />
                                        <TextBlock
                                            Width="30"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ViewModel.AppViewModel.Volume, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind ViewModel.AppViewModel.Volume, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>

        <!--  右侧播放列表面板(点按底栏列表按钮从右侧滑出, 覆盖整个播放页)  -->
        <Grid
            x:Name="CurrentPlayListOverlayPlayingDetail"
            Margin="0,32,0,0"
            Background="Transparent"
            Tapped="CurrentPlayListOverlayPlayingDetail_Tapped"
            Visibility="Collapsed">
            <Grid
                x:Name="CurrentPlayListPanelPlayingDetail"
                Width="340"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                CornerRadius="8,0,0,0"
                Tapped="CurrentPlayListPanelPlayingDetail_Tapped">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Background>
                    <AcrylicBrush
                        FallbackColor="{ThemeResource SolidBackgroundFillColorBase}"
                        TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                        TintOpacity="0.88" />
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  头部: 标题 + 数量 + 关闭  -->
                <Grid
                    Grid.Row="0"
                    Padding="16,12,6,12"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnDefinitions="*,Auto,Auto">
                    <TextBlock
                        x:Uid="PlayLists"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,2,12,2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingList.Count, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CurrentPlayListPanelPlayingDetailCloseButton_Click">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <ListView
                    x:Name="CurrentPlayListViewPlayingDetail"
                    Grid.Row="1"
                    Padding="0,0,0,8"
                    DoubleTapped="CurrentPlayListViewPlayingDetail_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.CurrentPlayingList, Mode=OneWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:Music">
                            <StackPanel Margin="2,6" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Author, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>