<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        AllowDrop="True"
        DragLeave="Grid_DragLeave"
        DragOver="Grid_DragOver"
        Drop="Grid_Drop">
        <!--  Loading 界面  -->
        <Grid x:Name="LoadingGrid" Visibility="Collapsed">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="正在处理数据，请稍候..." />
        </Grid>

        <!--  品牌主内容: 大字标题 + 副标题 + 搜索框(靠上方居中)  -->
        <Grid x:Name="BrandGrid">
            <StackPanel
                MaxWidth="1200"
                Margin="48,180,48,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Spacing="20">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="56"
                    FontWeight="Bold"
                    Text="XY Music" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Music is part of my life." />

                <!--  搜索框(含内嵌下拉) + 搜索按钮: 按钮在搜索框外侧右侧  -->
                <Grid ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0" x:Name="SearchPanel">
                        <!--  搜索框: 普通 TextBox, 垂直对称 Padding 自然撑高(文字天然居中),
                              右侧 Padding 加大让出原生清除按钮(✕)位置, 使 ✕ 位于下拉框左侧不重叠,
                              随窗口宽度伸缩(最大 1200)  -->
                        <TextBox
                            x:Name="SearchBox"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Padding="14,13,152,13"
                            KeyDown="SearchBox_KeyDown"
                            PlaceholderText="{x:Bind SearchPlaceholderText, Mode=OneWay}" />
                        <!--  内嵌无框下拉框: 在网络搜索 / 在本地搜索(项由 code-behind 本地化填充),
                              叠放在搜索框内右侧  -->
                        <ComboBox
                            x:Name="SearchScopeBox"
                            Width="128"
                            MinHeight="36"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            IsHitTestVisible="True"
                            SelectionChanged="SearchScopeBox_SelectionChanged" />
                    </Grid>
                    <!--  搜索按钮: 搜索框外侧右侧, 回车/点击均可触发搜索  -->
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="1"
                        MinWidth="96"
                        MinHeight="48"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Click="SearchButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE721;" />
                            <TextBlock x:Name="SearchButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!--  拖放反馈层（置于最上层，不拦截拖放事件）  -->
        <Grid
            x:Name="DropOverlay"
            Margin="12"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                CornerRadius="12"
                Opacity="0.35" />
            <Rectangle
                Margin="2"
                RadiusX="10"
                RadiusY="10"
                Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                StrokeDashArray="4,4"
                StrokeThickness="2" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8B7;" />
                <TextBlock
                    x:Uid="AddFolderPageDropOverlayText"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
