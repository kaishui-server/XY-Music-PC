<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        AllowDrop="True"
        DragLeave="Grid_DragLeave"
        DragOver="Grid_DragOver"
        Drop="Grid_Drop">
        <!--  Loading 界面  -->
        <Grid x:Name="LoadingGrid" Visibility="Collapsed">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="正在处理数据，请稍候..." />
        </Grid>

        <!--  空状态：新用户首启引导  -->
        <Grid x:Name="WelcomeGrid" Visibility="Collapsed">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                    <FontIcon
                        FontSize="44"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8B7;" />
                </Border>
                <TextBlock
                    x:Uid="AddFolderPageWelcomeTitle"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="AddFolderPageWelcomeSubtitle"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="EmptyAddFolderButton"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    Click="AddFolderButton_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock
                            x:Uid="AddFolder"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Opacity="0.6"
                    Orientation="Horizontal">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8B7;" />
                    <TextBlock
                        x:Uid="AddFolderPageDragHint"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  就绪状态：已有音乐文件夹  -->
        <Grid x:Name="ReadyGrid" Visibility="Collapsed">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                    <FontIcon
                        FontSize="44"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8D6;" />
                </Border>
                <TextBlock
                    x:Uid="AddFolderPageWelcomeTitle"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    TextAlignment="Center" />
                <StackPanel
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind FolderViewModel.FolderList.Count, Mode=OneWay}" />
                    <TextBlock
                        x:Uid="AddFolderPageFolderCountSuffix"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    Click="GoMusicBrowseButton_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE8D6;" />
                        <TextBlock
                            x:Uid="HomePageGoMusicBrowse"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  拖放反馈层（置于最上层，不拦截拖放事件）  -->
        <Grid
            x:Name="DropOverlay"
            Margin="12"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                CornerRadius="12"
                Opacity="0.35" />
            <Rectangle
                Margin="2"
                RadiusX="10"
                RadiusY="10"
                Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                StrokeDashArray="4,4"
                StrokeThickness="2" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8B7;" />
                <TextBlock
                    x:Uid="AddFolderPageDropOverlayText"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
