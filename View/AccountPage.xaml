<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    Loaded="AccountPage_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  登录/注册分段 Tab 样式: 选中态强调色胶囊  -->
        <Style x:Key="AccountSegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextOnAccentFillColorDefaultBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextOnAccentFillColorDefaultBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!--  页面标题  -->
        <TextBlock
            x:Name="TitleText"
            Margin="16,10,0,10"
            FontSize="28" />

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="520"
                Margin="16,8,16,8"
                HorizontalAlignment="Left"
                Spacing="16">

                <!-- ═══════════ 未登录: 登录/注册 ═══════════ -->
                <StackPanel
                    x:Name="AuthPanel"
                    Spacing="16"
                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.IsLoggedIn), Mode=OneWay}">
                    <!--  品牌头部  -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border
                            Width="64"
                            Height="64"
                            CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                    <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight1}" />
                                    <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorDark1}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon
                                Margin="0,0,0,2"
                                FontSize="32"
                                Foreground="White"
                                Glyph="&#xE8D6;" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="XY Music" />
                        <TextBlock
                            x:Name="BrandSubtitleText"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!--  登录/注册分段 Tab  -->
                    <Grid Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="10" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="LoginTabButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Checked="LoginTabButton_Checked"
                            IsChecked="True"
                            Style="{StaticResource AccountSegmentButtonStyle}" />
                        <RadioButton
                            x:Name="RegisterTabButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Checked="RegisterTabButton_Checked"
                            Style="{StaticResource AccountSegmentButtonStyle}" />
                    </Grid>

                    <!--  登录表单  -->
                    <StackPanel x:Name="LoginForm" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="LoginIdLabel" FontSize="13" />
                            <TextBox
                                x:Name="LoginIdBox"
                                IsEnabled="{x:Bind ViewModel.IsLoginBusy, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"
                                Text="{x:Bind ViewModel.LoginId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="LoginPasswordLabel" FontSize="13" />
                            <PasswordBox
                                x:Name="LoginPasswordBox"
                                IsEnabled="{x:Bind ViewModel.IsLoginBusy, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="LoginErrorText"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.LoginError, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="LoginButton_Click"
                            IsEnabled="{x:Bind ViewModel.IsLoginBusy, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    IsActive="{x:Bind ViewModel.IsLoginBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsLoginBusy, Mode=OneWay}" />
                                <TextBlock x:Name="LoginButtonText" />
                            </StackPanel>
                        </Button>
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="ForgotPassword_Click"
                            Content="?"
                            x:Name="ForgotPasswordLink" />
                    </StackPanel>

                    <!--  注册表单  -->
                    <StackPanel x:Name="RegisterForm" Spacing="12" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RegIdLabel" FontSize="13" />
                            <TextBox Text="{x:Bind ViewModel.RegId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RegNicknameLabel" FontSize="13" />
                            <TextBox Text="{x:Bind ViewModel.RegNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RegPasswordLabel" FontSize="13" />
                            <PasswordBox x:Name="RegPasswordBox" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RegConfirmLabel" FontSize="13" />
                            <PasswordBox x:Name="RegConfirmBox" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RegEmailLabel" FontSize="13" />
                            <TextBox Text="{x:Bind ViewModel.RegEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="RegCodeLabel" FontSize="13" />
                                <TextBox Text="{x:Bind ViewModel.RegCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Margin="8,19,0,0"
                                VerticalAlignment="Bottom"
                                Click="SendCode_Click">
                                <TextBlock x:Name="SendCodeButtonText" />
                            </Button>
                        </Grid>
                        <TextBlock
                            x:Name="RegisterErrorText"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.RegError, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="RegisterButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    IsActive="{x:Bind ViewModel.IsRegisterBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsRegisterBusy, Mode=OneWay}" />
                                <TextBlock x:Name="RegisterButtonText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- ═══════════ 已登录: 个人资料 ═══════════ -->
                <StackPanel
                    x:Name="ProfilePanel"
                    Spacing="16"
                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsLoggedIn), Mode=OneWay}">

                    <!--  头像 + 昵称  -->
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <Grid>
                            <Button
                                Padding="0"
                                HorizontalAlignment="Center"
                                Click="Avatar_Click"
                                CornerRadius="48">
                                <Grid Width="96" Height="96" CornerRadius="48">
                                    <!--  无头像时的人形占位  -->
                                    <FontIcon
                                        x:Name="AvatarPlaceholderIcon"
                                        Width="96"
                                        Height="96"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="40"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE77B;" />
                                    <!--  头像  -->
                                    <Ellipse x:Name="AvatarEllipse" Visibility="Collapsed">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </Button>
                            <ProgressRing
                                x:Name="AvatarUploadingRing"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsActive="{x:Bind ViewModel.IsAvatarUploading, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsAvatarUploading, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Name="AvatarHintText"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!--  资料卡片  -->
                    <Border
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="NicknameText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="{x:Bind ViewModel.User.Nickname, Mode=OneWay}" />
                            <TextBlock
                                x:Name="UserIdText"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="UserEmailText"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.User.Email, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  资料操作  -->
                    <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Click="RefreshProfile_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock x:Name="RefreshProfileText" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="EditNickname_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                <TextBlock x:Name="EditNicknameText" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Click="ChangePassword_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE192;" />
                                <TextBlock x:Name="ChangePasswordText" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="3"
                            Click="Logout_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE77B;" />
                                <TextBlock x:Name="LogoutText" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  云同步卡片  -->
                    <Border
                        Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="CloudSyncTitleText" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Name="CloudSyncEnableText"
                                    VerticalAlignment="Center"
                                    FontSize="13" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.CloudSyncEnabled, Mode=TwoWay}"
                                    Toggled="CloudSyncToggle_Toggled" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock
                                    x:Name="CloudSyncFrequencyText"
                                    VerticalAlignment="Center"
                                    FontSize="13" />
                                <ComboBox
                                    x:Name="FrequencyComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="FrequencyComboBox_SelectionChanged" />
                            </Grid>
                            <Button
                                HorizontalAlignment="Stretch"
                                Click="SyncNow_Click"
                                IsEnabled="{x:Bind ViewModel.IsCloudSyncing, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        Width="14"
                                        Height="14"
                                        IsActive="{x:Bind ViewModel.IsCloudSyncing, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsCloudSyncing, Mode=OneWay}" />
                                    <TextBlock x:Name="SyncNowText" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                x:Name="LastSyncText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  状态栏  -->
        <TextBlock
            Grid.Row="2"
            Margin="16,8,16,12"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
