<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.OnlineArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:vm="using:WinUIMusicPlayer.ViewModel.Pages"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!--  返回按钮: 左上角独立一行  -->
        <Grid Grid.Row="0" Margin="16,8,16,0">
            <Button
                Padding="8,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                    <TextBlock x:Uid="OnlineSearchBack" />
                </StackPanel>
            </Button>
        </Grid>
        <!--  歌手信息栏(仿歌单详情)  -->
        <Grid
            Grid.Row="1"
            Margin="16,12,16,10"
            ColumnDefinitions="Auto,*">
            <!--  歌手头像(圆形)  -->
            <Border
                Grid.Column="0"
                Width="150"
                Height="150"
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                CornerRadius="75">
                <Grid>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="50"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE77B;" />
                    <Border CornerRadius="75">
                        <Image Stretch="UniformToFill">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:FadeImageBehavior ImageHash="{x:Bind ViewModel.ArtworkHash, Mode=OneWay}" Duration="00:00:0.3" />
                            </interactivity:Interaction.Behaviors>
                        </Image>
                    </Border>
                </Grid>
            </Border>
            <Grid
                Grid.Column="1"
                RowDefinitions="Auto,Auto,*"
                VerticalAlignment="Center">
                <TextBlock
                    Grid.Row="0"
                    FontSize="30"
                    FontWeight="Bold"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Padding="16,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.PlayAllCommand, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock x:Uid="PlayAll" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!--  作品歌曲列表  -->
        <ListView
            Grid.Row="2"
            Margin="16,4,16,0"
            HorizontalAlignment="Stretch"
            DoubleTapped="ResultList_DoubleTapped"
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OnlineSongItem">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="4,4">
                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4">
                            <Grid>
                                <!--  无封面占位  -->
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Glyph="&#xE8D6;" />
                                <!--  封面: ArtworkHash 有值后由 FadeImageBehavior 淡入  -->
                                <Image Stretch="UniformToFill">
                                    <interactivity:Interaction.Behaviors>
                                        <behaviors:FadeImageBehavior ImageHash="{x:Bind ArtworkHash, Mode=OneWay}" Duration="00:00:0.3" />
                                    </interactivity:Interaction.Behaviors>
                                </Image>
                            </Grid>
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind Artist, Mode=OneWay}" />
                                <Run Text=" — " />
                                <Run Text="{x:Bind Album, Mode=OneWay}" />
                                <Run Text=" (" />
                                <Run Text="{x:Bind Platform, Mode=OneWay}" />
                                <Run Text=")" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind DurationText, Mode=OneWay}" />
                        <!--  ⋯ 菜单: 播放 / 添加到歌单  -->
                        <Button
                            Grid.Column="3"
                            Padding="8,4"
                            IsEnabled="{x:Bind IsResolving, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Uid="OnlineItemPlay"
                                        Click="PlayButton_Click"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Uid="OnlineItemAddToPlayList"
                                        Click="AddToPlayListMenu_Click"
                                        Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource MaterialDesignIconsFontFamily}" Glyph="&#xF0412;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  底部: 加载更多  -->
        <Grid
            Grid.Row="3"
            Margin="16,8,16,12"
            ColumnDefinitions="Auto,*">
            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.LoadMoreCommand, Mode=OneWay}"
                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.CanLoadMore), Mode=OneWay}">
                <TextBlock x:Uid="OnlineSearchMore" />
            </Button>
            <ProgressRing
                Grid.Column="0"
                Width="22"
                Height="22"
                Margin="16,0,0,0"
                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsSearching), Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
