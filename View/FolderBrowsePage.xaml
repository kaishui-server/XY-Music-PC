<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.FolderBrowsePage"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    mc:Ignorable="d">
    <Grid Margin="0">
        <SemanticZoom
            x:Name="BrowseZoom"
                    IsHitTestVisible="{x:Bind tools:BindUtils.BoolToBoolReConverter(ViewModel.IsInDetailMode), Mode=OneWay}"
            Opacity="{x:Bind tools:BindUtils.BoolToOpacityReConverter(ViewModel.IsInDetailMode), Mode=OneWay}">
            <SemanticZoom.ZoomedInView>
                <ListView
                    x:Name="FolderListView"
                    Margin="10,0,10,0"
                    IsItemClickEnabled="True"
                    IsRightTapEnabled="True"
                    ItemClick="FolderListView_ItemClick"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.FolderPageSource.View, Mode=OneWay}"
                    RightTapped="Folder_RightTapped"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2" />
                            <Setter Property="ContextFlyout">
                                <Setter.Value>
                                    <MenuFlyout extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.FolderMenuOptions, Mode=OneWay}" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="model:MusicGroup">
                                    <TextBlock
                                        Margin="6,10,6,6"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Key}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.HeaderContainerStyle>
                                <StaticResource ResourceKey="NoBorderListViewHeaderItemStyle" />
                            </GroupStyle.HeaderContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:Music">
                            <!--  横条状文件夹卡片: 左封面 + 中名称/路径 + 右状态图标  -->
                            <Border
                                Padding="12,8"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="44">
                                    <!--  封面缩略图(连接动画锚点)  -->
                                    <Grid Grid.Column="0" Width="44" Height="44">
                                        <Border
                                            x:Name="CoverBorder"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="6">
                                            <Grid>
                                                <Image
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Canvas.ZIndex="1"
                                                    Stretch="UniformToFill">
                                                    <interactivity:Interaction.Behaviors>
                                                        <behaviors:AlbumCoverBehavior Music="{x:Bind Mode=OneWay}" />
                                                    </interactivity:Interaction.Behaviors>
                                                </Image>
                                                <Grid
                                                    Width="44"
                                                    Height="44"
                                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                    Canvas.ZIndex="0">
                                                    <FontIcon
                                                        Canvas.ZIndex="0"
                                                        FontSize="18"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xf12b;" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <FontIcon
                                            Margin="0,0,-4,-4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="13"
                                            Glyph="{x:Bind tools:BindUtils.IsExistOnDeviceGlyphConverter(IsExistOnDevice), Mode=OneWay}" />
                                    </Grid>
                                    <!--  文件夹名 + 完整路径  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind LastLevelFolderPath, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FolderPath, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!--  右侧进入箭头  -->
                                    <FontIcon
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE76B;" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </SemanticZoom.ZoomedInView>
            <SemanticZoom.ZoomedOutView>
                <GridView
                    x:Name="ZoomedOutGridView"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.FolderPageSource.View.CollectionGroups, Mode=OneWay}"
                    ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                    ScrollViewer.IsVerticalScrollChainingEnabled="False"
                    ScrollViewer.ZoomMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="ICollectionViewGroup">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="32"
                                Text="{x:Bind Group.(model:MusicGroup.Key), Mode=OneWay}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>
        <controls:MusicGroupDetailControl
            x:Name="DetailView"
            DetailKind="Folder"
            PlaySourceTag="FolderSongsView"
            IsHitTestVisible="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay}"
                    Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.IsInDetailMode), Mode=OneWay}"
            x:FieldModifier="public" />
    </Grid>
</Page>
